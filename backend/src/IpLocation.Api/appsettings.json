{
  "Urls": "http://127.0.0.1:5080",
  "AllowedHosts": "*",
  "IdGeneration": {
    "WorkerId": 1
  },
  "Database": {
    "Enabled": false,
    "ConnectionStringName": "IpLocation",
    "CommandTimeoutSeconds": 10
  },
  "Query": {
    "DefaultDatabase": "dbip",
    "ProviderTimeoutMs": 2500,
    "TotalTimeoutMs": 5000,
    "MaxConcurrentSources": 4
  },
  "TrustedProxies": {
    "KnownProxies": [],
    "KnownIPNetworks": [],
    "ForwardLimit": 1
  },
  "Console": {
    "_comment": "后台访问白名单示例。192.0.2.0/24 与 198.51.100.0/24 属于 RFC 5737 文档示例网段，仅用于演示格式，请替换为实际管理网段。",
    "AllowedNetworks": [
      "127.0.0.1",
      "::1",
      "192.0.2.0/24",
      "198.51.100.0/24"
    ]
  },
  "GeoLite2": {
    "Enabled": false,
    "DatabasePath": ""
  },
  "ConsoleAuth": {
    "SessionMinutes": 480,
    "KeyRingPath": ""
  },
  "DbIp": {
    "Enabled": false,
    "DatabasePath": ""
  },
  "Ipinfo": {
    "Enabled": false,
    "DatabasePath": ""
  },
  "Ip2Region": {
    "Enabled": false,
    "Ipv4DatabasePath": "",
    "Ipv6DatabasePath": "",
    "MaxDatabaseBytes": 268435456
  },
  "IP2Location": {
    "_comment": "开源默认不启用：取得 IP2Location LITE DB11 数据库并确认其许可条款后，再将 Enabled 设为 true 并配置 DatabasePath。",
    "Enabled": false,
    "DatabasePath": ""
  },
  "AccessLogging": {
    "_comment": "开源默认不保存完整来源 IP（RetainFullSourceIp=false），仅在明确排障需要时开启，并自行评估隐私与合规要求。",
    "Enabled": true,
    "QueueCapacity": 10000,
    "BatchSize": 500,
    "FlushIntervalMilliseconds": 1000,
    "RetainFullSourceIp": false,
    "RecentEventRetentionDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
