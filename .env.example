# 环境变量示例
# 复制为 deploy/docker/.env（或部署目录下的 .env）后填写实际值。
# 不要把填写后的 .env 提交到 Git；真实凭据只放在部署机的私有文件中。
#
# 注意：这是 Docker Compose 编排使用的环境变量。本地 dotnet run 的配置
# 通过 appsettings.json、环境变量或 --Runtime:SettingsFile 指定的文件提供。

# PostgreSQL 密码（必填，请替换为强随机值）
IPLOCATION_DB_PASSWORD=CHANGE_ME

# API 镜像标签（对应 registry 中实际存在的 tag）
IPLOCATION_API_TAG=latest

# API 在宿主机上的监听地址；只允许反向代理访问时建议设为 127.0.0.1
IPLOCATION_API_BIND_ADDRESS=0.0.0.0

# 直接反向代理/网关的精确地址；仅在确实前置了反向代理时设置，
# 不要填写整个私有网段，也不要信任任意转发头。
IPLOCATION_TRUSTED_PROXY_ADDRESS=172.18.0.1

# 可选：ASP.NET Core 环境
ASPNETCORE_ENVIRONMENT=Production

# 可选：数据库连接串（如不使用 compose 内置的拼接方式，可显式提供）。
# 生产凭据应从密钥管理或环境注入，不要写入源码。
# ConnectionStrings__IpLocation=Host=localhost;Port=5432;Database=iplocation;Username=iplocation;Password=CHANGE_ME

# 可选：会话密钥目录（必须为仓库外可持久化目录）
# ConsoleAuth__KeyRingPath=/absolute/path/to/keys

# 产品安装心跳（默认开启，用于统计安装量；设为 false 可关闭自动上报）
Support__TelemetryEnabled=true

# 安装身份目录（compose 部署时由卷并提供；本地运行时默认在用户本地应用数据目录）
Support__StateDirectory=/support
