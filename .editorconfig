root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,slnx,props,targets}]
indent_size = 4

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf

[*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.{png,jpg,jpeg,webp,avif,gif,ico}]
insert_final_newline = false
